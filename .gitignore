# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Data & model artifacts (tracked via README instructions, not git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
models/*
!models/.gitkeep
*.pt
*.onnx
*.engine

# Ngoại lệ: models/best.onnx được track qua Git LFS (không phải commit
# thẳng binary vào git thường) để Render build được model thật từ chính
# repo GitHub này — xem docs/specs/g9-deploy-public.md T9.4. Các file .pt
# checkpoint train và các bản .onnx thử nghiệm khác vẫn bị ignore bình
# thường (chỉ 1 file cụ thể này được ngoại lệ).
!models/best.onnx

# Env / secrets
.env
*.key

# OS
.DS_Store
Thumbs.db

# Saved web pages (reference material, not project code)
docs/reference/*.html
docs/reference/*_files/
